{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tau",
  "version": "0.1.0",
  "identifier": "home.tau.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Tau",
        "width": 480,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "hiddenTitle": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "Tau"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
