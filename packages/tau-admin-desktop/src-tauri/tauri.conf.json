{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tau Admin",
  "version": "0.1.0",
  "identifier": "home.tau.admin",
  "build": {
    "devUrl": "http://localhost:3100",
    "frontendDist": "../../admin-frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Tau Admin",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "hiddenTitle": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
