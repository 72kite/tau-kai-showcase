# Copy this to .env and fill in real values. Never commit the real .env file.
#
# This is a stand-in for Phase 0's Vault deployment - see tau_core.config.secrets. Once Vault
# is live, swap in a VaultSecretsProvider without changing anything that calls SecretsProvider.

# TAU_ROUTING_CONFIDENCE_THRESHOLD=0.6
# TAU_SESSION_MAX_MESSAGES=50

# --- Durability & timeouts (Phase 7 Tier 0) ---------------------------------------------------
# Where pending human approvals persist. Durable by DEFAULT (tau-core/data/approvals.json), so
# you only set this to move it - docker-compose.yml points it at a volume (/data/approvals.json)
# because the container filesystem is ephemeral. The approval queue is the mechanism the whole
# architecture rests on; a restart used to silently drop every pending decision. Set to an empty
# value for a purely in-memory queue (loses approvals on restart - tests do this).
# TAU_APPROVAL_STORE_PATH=./data/approvals.json
#
# Where device-approval state persists (Phase 27.A) - which devices an admin has approved and
# the hash of each one's minted bearer token. Same durable-by-default reasoning: an approved
# device losing its token on every restart would force re-approval on every deploy.
# TAU_DEVICE_STORE_PATH=./data/devices.json
#
# When true, an identified device (X-Tau-Device-Id) must also present a valid X-Tau-Device-Token
# minted by an admin approval, or the request gets a 403 - covers /api/state, /api/chat, the
# admin/activity/drafts/transcript/approvals reads, the generic tool passthrough, and the whole
# voice/* family (Phase 27.A steps 2-3). ON by default since Phase 48 (2026-09-16) - it was off
# from 2026-08-19 only long enough to soak in real use first, per §8.28 step 6. Approve every
# real device from the admin dashboard BEFORE relying on this default, or it locks your own
# kiosks out - set TAU_REQUIRE_DEVICE_TOKEN=false to go back to loud-but-open if you haven't yet.
# Note: a caller that sends no X-Tau-Device-Id at all is still unaffected by this setting on every
# route (identification itself isn't mandatory yet) - see project-tau-plan.md §8.28 step 3's
# "deliberate scope limit" note.
# TAU_REQUIRE_DEVICE_TOKEN=true
#
# Durable audit trail. UNSET = stderr only (the pre-Phase-7 behaviour, which meant the audit
# trail lived in a container's stdout and died with it). Set it to get a rotating JSON-lines file
# alongside stderr; compose points it at the same volume. Loki/Grafana (Phase 0) still consumes
# the stderr stream - this is a durable local copy, not a replacement.
# TAU_AUDIT_LOG_PATH=./data/audit/audit.log
# TAU_AUDIT_LOG_MAX_BYTES=10485760
# TAU_AUDIT_LOG_BACKUP_COUNT=5
#
# Timeouts. Every one of these bounds a HANG, not slowness - they're deliberately generous
# because a local model on CPU is slow but not broken. Before Phase 7 there were none at all, so
# a wedged Ollama meant a POST /api/chat that never returned.
# TAU_MCP_CALL_TIMEOUT_SECONDS=30        # one MCP tool call; exceeding it reconnects that server
# TAU_MCP_CONNECT_TIMEOUT_SECONDS=20     # opening/initializing one MCP session
# TAU_LLM_REQUEST_TIMEOUT_SECONDS=120    # one HTTP request to Ollama
# TAU_LLM_TURN_TIMEOUT_SECONDS=300       # one whole chat turn (several requests + tool calls)
# Default reply language (hard default, pinned in the system prompt so small local models don't
# drift into another language when tool output accumulates). English by default; set to another
# language name to change it. Users can still ask for a different language mid-conversation.
# TAU_REPLY_LANGUAGE=English
#
# Timezone utility-mcp-server reports the current time/date in (IANA name, e.g.
# America/New_York) - read from THIS file, not its own (docker-compose.yml points
# utility-mcp-server at tau-core/.env for it). UNSET = the container's system zone, which is
# UTC unless the image/host says otherwise - almost never what you want for a home assistant
# reporting the current time to a person.
# TAU_TIMEZONE=
#
# --- Encryption at rest (Phase 10) ------------------------------------------------------------
# Turns on encryption-at-rest for the approval queue (TAU_APPROVAL_STORE_PATH), which carries
# raw voiceprint embeddings (see web/server.py's voice_enroll), and for the device registry
# (TAU_DEVICE_STORE_PATH), which carries the sha256 hash of each approved device's bearer token.
# Argon2id derives the real key
# from this passphrase; AES-256-GCM encrypts the file. UNSET = plaintext, unchanged from before
# Phase 10 - a fresh install needs no setup. There is no recovery if you lose this: Argon2id is
# one-way and nothing else remembers the passphrase.
#
# The SAME value must also be set in phase4-upgrade-pipeline/.env and memory-mcp-server/.env for
# their own stores (proposals.json, profiles.json), and in ui-bridge-mcp-server/.env so it can
# keep reading phase4's proposals.json (it reads that file straight off the shared volume, not
# over MCP - see docker-compose.yml).
# TAU_MASTER_KEY=
#
# --- vLLM primary (opt-in) --------------------------------------------------------------------
# When set, the main reply model tries vLLM FIRST and falls back to OLLAMA_MODEL below on a vLLM
# API error (down, OOM, wrong --served-model-name). Both VLLM_HOST and VLLM_MODEL must be set
# together to activate - one without the other is ignored, with a warning, same all-or-nothing
# gate as OPENROUTER below. The router (tool-selection confidence check) stays Ollama-only
# regardless - it's a small fast model that runs every turn, not worth moving to vLLM's heavier
# serving stack. Point VLLM_HOST at wherever `vllm serve` is actually running - a separate GPU
# host, not necessarily the same machine as Ollama.
# VLLM_HOST=http://localhost:8000
# VLLM_MODEL=
# VLLM_API_KEY=

# --- OpenRouter fallback (Phase 10) -----------------------------------------------------------
# Opt-in paid fallback for when local vLLM/Ollama are both down or under-powered. Both must be
# set together to activate - OPENROUTER_API_KEY alone is ignored (skipped with a warning) rather
# than guessing a model and surprising you with a bill. Only the main reply model falls over to
# OpenRouter (after vLLM and Ollama), not the router. See https://openrouter.ai/models for model
# IDs.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

OLLAMA_HOST=http://localhost:11434
# Best-evaluated main model (2026-07-11, 7/8 tool selection, no JSON leakage) - see infra/ollama/models.md.
# Phase 6.A: scripts/bring-up-tau.ps1 auto-overwrites this to a model that fits the detected GPU
# (e.g. an 8 GB card -> qwen2.5:7b-instruct so it stays fully on-GPU). Re-run the picker any time:
#   python -m tau_core.hardware --write     (add --cpu-only if the GPU isn't passed to Docker)
OLLAMA_MODEL=qwen2.5:14b-instruct
# Router (confidence pre-check). Same model as OLLAMA_MODEL deliberately: sharing one model
# avoids Ollama swapping two in and out of memory - which is not just slow, it makes the router
# FAIL (measured 2026-07-15: a 14b evicting a 7b made every router sample raise).
#
# The router is a HINT, not a safety control - the CDG gates every call regardless. Since
# 2026-07-15 a router that cannot score reports "no opinion" and Tau proceeds, so a bad
# OLLAMA_ROUTER_MODEL now costs you the hint rather than every tool you own. Before that fix,
# this line silently disabled all 77 tools. hermes3:8b still cannot score at all; qwen2.5:7b-instruct,
# llama3.1:8b and qwen2.5:14b-instruct all separate a matching call (0.9) from a mismatched one
# (0.0-0.1). See project-tau-plan.md §10 and infra/ollama/models.md.
OLLAMA_ROUTER_MODEL=qwen2.5:14b-instruct

# Local speech-to-text service (infra/whisper - faster-whisper behind an OpenAI-compatible
# endpoint). voice-mcp-server's transcribe tool needs this; the frontend's VITE_VOICE_MODE=local
# capture path depends on it end to end.
WHISPER_URL=http://localhost:9000
