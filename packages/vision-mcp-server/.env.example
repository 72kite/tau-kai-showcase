# An integer selects a plain UVC webcam by OpenCV device index (0 = the system default).
# CAMERA_SOURCE=kinect2 switches to the Kinect v2 backend (kinect2_client.py, libfreenect2) -
# a Kinect v2 is NOT a UVC webcam and cv2.VideoCapture cannot open it at all, so this is a real
# backend switch, not just a different index. Needs libfreenect2 built into the image (see
# docker/vision.Dockerfile) and the device actually passed through to wherever this container
# runs (LXC/Docker device passthrough - host-specific, not something this .env can configure).
CAMERA_SOURCE=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
PTZ_URL=http://localhost:8000
PTZ_ENABLED=false
FACE_DETECTION_ENABLED=true
SCENE_DESCRIPTION_ENABLED=true

# Immich integration (dormant — for learning from personal photo library)
IMMICH_ENABLED=false
IMMICH_API_URL=http://localhost:2283
IMMICH_API_KEY=

# AirTouch / TUIO touch tracking (https://github.com/jing-interactive/AirTouch) — reads touch
# points broadcast by a depth-camera-driven multitouch surface (Kinect/RealSense/OpenNI). Point
# TUIO_HOST/TUIO_PORT at wherever AirTouch is actually running; 127.0.0.1:3333 matches its own
# default (see its include/item.def). Any other TUIO 1.1 source works too.
TOUCH_ENABLED=false
TUIO_HOST=127.0.0.1
TUIO_PORT=3333
