# Copy this to .env and fill in real values. Never commit the real .env file.

# PROPOSAL_DB_PATH: JSON file for the self-upgrade proposal queue. Defaults to ./data/proposals.json.
# PROPOSAL_DB_PATH=./data/proposals.json

# Encryption at rest for PROPOSAL_DB_PATH (Phase 10). Must match the TAU_MASTER_KEY set in
# tau-core/.env - see that file for the full explanation. UNSET = plaintext, unchanged. The same
# value also needs to be set in ui-bridge-mcp-server/.env, which reads this file directly.
# TAU_MASTER_KEY=
