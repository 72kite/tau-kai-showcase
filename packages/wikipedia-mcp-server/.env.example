# Copy this to .env and fill in real values. Never commit the real .env file.
#
# KIWIX_URL points at a self-hosted kiwix-serve instance (docker-compose.yml's `kiwix-serve`
# service, image ghcr.io/kiwix/kiwix-serve).
# KIWIX_ZIM_NAME is the loaded ZIM's filename on disk, without the .zim extension - NOT the ZIM's
# internal metadata name, which can differ (see kiwix.py's module docstring). This stays fixed
# across ZIM upgrades because infra/kiwix/pull-wikipedia-zim.sh always saves the file under this
# same name regardless of which variant it downloaded.

KIWIX_URL=http://localhost:8080
KIWIX_ZIM_NAME=wikipedia
