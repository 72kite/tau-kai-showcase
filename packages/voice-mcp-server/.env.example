# Copy this to .env and fill in real values. Never commit the real .env file.
#
# WHISPER_URL points at the faster-whisper-server OpenAI-compatible REST API
# (infra/k3s/voice/whisper-deployment.yaml, image fedirz/faster-whisper-server).
# PIPER_URI points at the Wyoming-protocol Piper TTS service
# (infra/k3s/voice/piper-deployment.yaml, image rhasspy/wyoming-piper).

WHISPER_URL=http://localhost:8000
PIPER_URI=tcp://localhost:10200

# PIPER_VOICE sets the FIRST-run spoken voice only. Switching it live is the Admin Dashboard's
# VOICE panel (set_voice), which persists its choice and takes priority over this once used.
# Must name a voice the piper-voice-seed step actually downloaded, or speak() falls back to
# whatever Piper was started with. See tts_voice.AVAILABLE_VOICES for the list.
# PIPER_VOICE=en_US-lessac-medium
