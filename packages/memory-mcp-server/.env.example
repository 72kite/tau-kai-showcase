# Copy this to .env and fill in real values. Never commit the real .env file.
#
# MEMORY_DB_PATH: local directory for Chroma's persistent vector store (face/voice embeddings).
# MEMORY_PROFILES_PATH: JSON file for person_id -> {access_level, ...} profiles.
# Both default to ./data/... if unset.
#
# MEMORY_DB_PATH (Chroma) stays plaintext even with TAU_MASTER_KEY set below - its similarity
# search needs plaintext float vectors to build its index, so field-level encryption isn't
# possible there. Real protection for that path is OS/volume-level disk encryption (a Phase 0
# infra concern, not something this package enforces).

MEMORY_DB_PATH=./data/chroma
MEMORY_PROFILES_PATH=./data/profiles.json

# Encryption at rest for MEMORY_PROFILES_PATH (Phase 10). Must match the TAU_MASTER_KEY set in
# tau-core/.env - see that file for the full explanation. UNSET = plaintext, unchanged.
# TAU_MASTER_KEY=
