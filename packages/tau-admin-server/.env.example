# Where tau-core (the kiosk-facing bridge) is reachable, and the shared secret this service
# authenticates itself with. TAU_ADMIN_TAU_CORE_SERVICE_TOKEN here must equal
# TAU_ADMIN_SERVICE_TOKEN in tau-core's own .env - generate one long random value and copy it to
# both, e.g. `openssl rand -hex 32`.
TAU_ADMIN_TAU_CORE_BASE_URL=http://tau-core:8000
TAU_ADMIN_TAU_CORE_SERVICE_TOKEN=

# Bearer token for the synthetic "tau-admin-server" device this service authenticates its
# tau-core proxy calls as (proxy.py). Needed since Phase 48 turned TAU_REQUIRE_DEVICE_TOKEN on by
# default over on tau-core - without it, only the drafts promote/discard passthrough 403s
# (everything else here goes through _require_admin, unaffected). Get the value by approving the
# "tau-admin-server" device from tau-core's admin dashboard (or
# POST /api/admin/devices/tau-admin-server/approve) and pasting the one-time token shown there.
# TAU_ADMIN_TAU_CORE_DEVICE_TOKEN=

# First-run only: creates the single admin account if (and only if) no credential store exists
# yet. Unset these once you've logged in - they have no effect after the first boot, and are not
# a way to reset a forgotten password (use POST /change-password while logged in for that; there
# is deliberately no "reset" endpoint, since anyone who can edit this .env would otherwise be able
# to seize the account).
TAU_ADMIN_BOOTSTRAP_USERNAME=
TAU_ADMIN_BOOTSTRAP_PASSWORD=

# Optional: turns on encryption-at-rest for the admin credential and session stores, same
# TAU_MASTER_KEY convention as every other durable store in this project. Recommended, since this
# store holds a household's only admin password hash.
# TAU_MASTER_KEY=

# The real admin frontend's origin(s), comma-separated. Empty (the default) allows none - unlike
# tau-core's LAN-trust default, this is a new and more sensitive surface, so it starts closed
# rather than open. Actual network reachability should still be restricted separately (bind this
# service to a VPN-only interface or Docker-internal network, not the open LAN).
TAU_ADMIN_ALLOWED_ORIGINS=

# How long a login session lasts before requiring another password entry. Default 12h.
# TAU_ADMIN_SESSION_TTL_SECONDS=43200

# Bind address/port for `python -m tau_admin_server` (docker-compose sets these directly instead).
# TAU_ADMIN_BIND_HOST=0.0.0.0
# TAU_ADMIN_BIND_PORT=8100
