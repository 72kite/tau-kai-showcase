# Copy this to .env and fill in real values. Never commit the real .env file.
#
# Required for exit_lockdown to work at all (server.py raises RuntimeError without it) - and
# genuinely secret: anyone who knows this value can exit lockdown. Generate a real random value
# (scripts\setup-wizard.ps1 will do this for you) rather than leaving a placeholder in here -
# a literal placeholder deployed as-is is the same failure mode as a default password.

SECURITY_DB_PATH=./data/security.json
LOCKDOWN_APPROVAL_TOKEN=
