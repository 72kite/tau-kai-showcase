# Base URL of tau-core's HTTP bridge (tau_core.web.server). Defaults to
# http://<current-hostname>:8000 if unset - only needed if the bridge runs on a different
# host/port than the tablet expects (e.g. tau-core on a dedicated Proxmox VM).
VITE_TAU_API_BASE=http://localhost:8000

# Wake phrase for "browser" voice mode only (see src/hooks/useVoiceInvoke.js) - case-insensitive
# substring match against SpeechRecognition's transcript. "local" mode's wake word is a separate,
# on-device openWakeWord model instead (voice-mcp-server's WAKEWORD_MODEL - see
# docker-compose.yml), not this phrase. Requires a secure context (HTTPS or localhost) for
# microphone access in most browsers.
VITE_WAKE_PHRASE=hey tau

# Voice capture engine. "local" (default) = MediaRecorder -> tau-core /api/voice/transcribe ->
# voice-mcp-server -> the local faster-whisper service (infra/whisper), fully offline - no audio
# ever leaves the LAN. Hands-free wake word comes from voice-mcp-server's own locally-trained
# "hey tau" openWakeWord model (detect_wake_word via /api/voice/wake, polled by useWakeWord.js):
# a two-beat gesture, wake word then pause then command, since detection is acoustic-only and
# can't parse a trailing command out of one utterance the way "browser" mode can. Its recall is
# modest (~36% at the default threshold - see voice-mcp-server/README.md for the measured curve),
# so double-tap remains the reliable fallback. The atom double-tap always invokes too, either mode.
# "browser" = SpeechRecognition instead: wake phrase + command in one fluid sentence, but Chrome's
# implementation sends the audio to Google's cloud recognizer to get it.
VITE_VOICE_MODE=local

# Wake-word poll window, local mode only (src/hooks/useWakeWord.js) - seconds of rolling audio
# sent to detect_wake_word per poll. Longer catches slower speech; shorter lowers latency.
VITE_WAKEWORD_WINDOW_SECONDS=1.3

# Bounded conversational follow-up (Phase 17, see src/hooks/useVoiceInvoke.js). After Tau finishes
# SPEAKING a voice reply, a short window opens in which a bare utterance - no wake phrase - is
# accepted as a continuation, then it times out back to idle. Set ENABLED=false to require the wake
# phrase on every turn; WINDOW_MS tunes how long the window stays open (default 7000ms). A sleep
# phrase ("stop listening", "go away" - see src/utils/voiceMatch.js) works in this window too and
# puts the wake word to sleep instead of treating the phrase as a command.
# SETTLE_MS (bug found 2026-09-08): grace period after the window opens before speech/transcripts
# count as real - the window opens the instant Tau's own TTS ends, and on hardware with no real
# AEC (one mic, one speaker) the room echo of that reply was getting picked up and answered,
# re-arming follow-up and looping. Raise this if a kiosk's echo takes longer than 700ms to decay.
VITE_FOLLOWUP_ENABLED=true
VITE_FOLLOWUP_WINDOW_MS=7000
VITE_FOLLOWUP_SETTLE_MS=700

# Barge-in (Phase 19): say the wake phrase WHILE Tau is speaking to interrupt the reply and start a
# new command, instead of waiting for it to finish. This is only the first-run default - it's a
# per-device toggle (the ✋ glyph in the toolbar), persisted in localStorage. **Off by default**
# (2026-08-19) - it was shipped on under the assumption that echoCancellation reliably cancels
# Tau's own TTS out of the mic; that doesn't hold on real kiosk hardware (one mic, one speaker, no
# hardware AEC), causing the same self-triggering-loop failure mode as the follow-up bug above.
# Only flip this to true for a device with genuinely good hardware AEC. See BARGE_IN_DEFAULT in
# App.jsx for the full rationale.
VITE_BARGE_IN_DEFAULT=false

# Device Globe panel (src/components/DeviceGlobe.jsx): where to place the "home" pin. The
# device_tracker/person entities behind this panel only carry home/not_home (router-connection
# presence, not GPS), so there's nothing to plot for an "away" device's actual position - it's
# just listed separately. Left unset, the globe centers on 0,0 with a note to configure this.
VITE_HOME_LAT=
VITE_HOME_LON=
