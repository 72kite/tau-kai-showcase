# UI bridge does not require external credentials — it aggregates Resources
# from other servers (which must be running and reachable from tau-core).

# PROPOSAL_DB_PATH: where phase4-mcp-server's proposal queue lives - read directly off the shared
# phase4-data volume (not over MCP). Defaults to ./data/proposals.json.
# PROPOSAL_DB_PATH=./data/proposals.json

# Must match the TAU_MASTER_KEY set in tau-core/.env and phase4-upgrade-pipeline/.env (Phase 10)
# if that store is encrypted, so this server can keep decrypting it. UNSET = plaintext, unchanged.
# TAU_MASTER_KEY=
